+    sd_loom_krea_event_cb_v6_t activation_callback,
+    void* activation_callback_data,
+    sd_loom_value_handle_v3_t* snapshot_values,
+    size_t snapshot_capacity,
+    sd_loom_model_block_application_v5_t* model_block_results,
+    size_t model_block_capacity,
+    uint64_t* transition_masks,
+    size_t transition_mask_capacity,
+    sd_loom_krea_capture_result_v6_t* capture_results,
+    size_t capture_capacity,
+    sd_loom_krea_application_result_v6_t* application_results,
+    size_t application_capacity,
+    sd_loom_program_image_result_v6_t* result_out) {
+    if (result_out != nullptr) {
+        *result_out = {
+            SD_LOOM_KREA_ACTIVATION_ABI_VERSION,
+            {
+                SD_LOOM_MODEL_BLOCK_APPLICATION_ABI_VERSION,
+                {
+                    SD_LOOM_PROGRAM_ABI_VERSION,
+                    sd_loom_empty_handle_v3(),
+                    sd_loom_empty_handle_v3(),
+                    0,
+                },
+                0,
+                0,
+                0,
+            },
+            0,
+            0,
+            0,
+            0,
+            0,
+        };
+    }
+    if (capture_results != nullptr) {
+        std::fill(capture_results,
+                  capture_results + capture_capacity,
+                  sd_loom_krea_capture_result_v6_t{});
+    }
+    if (application_results != nullptr) {
+        std::fill(application_results,
+                  application_results + application_capacity,
+                  sd_loom_krea_application_result_v6_t{});
+    }
+    if (!sd_loom_program_live_v3(program) || params == nullptr ||
+        result_out == nullptr ||
+        params->abi_version != SD_LOOM_KREA_ACTIVATION_ABI_VERSION ||
+        params->image.abi_version != SD_LOOM_MODEL_BLOCK_APPLICATION_ABI_VERSION ||
+        params->image.image.abi_version != SD_LOOM_PROGRAM_ABI_VERSION ||
+        params->image.image.sigma_count < 2 ||
+        params->image.image.sigma_count > 4097 ||
+        params->capture_count > 128 || params->operation_count > 256 ||
+        (params->capture_count == 0 && params->operation_count == 0) ||
+        params->maximum_host_bytes > 64ull * 1024 * 1024 ||
+        params->maximum_device_bytes > 64ull * 1024 * 1024 ||
+        params->maximum_applications == 0 ||
+        params->maximum_applications > 1000000 ||
+        (params->capture_count > 0 && params->captures == nullptr) ||
+        (params->operation_count > 0 && params->operations == nullptr) ||
+        capture_capacity != params->capture_count ||
+        application_capacity != params->operation_count ||
+        (capture_capacity > 0 && capture_results == nullptr) ||
+        (application_capacity > 0 && application_results == nullptr) ||
+        model_block_capacity != params->image.model_block_operator_count ||
+        (model_block_capacity > 0 && model_block_results == nullptr) ||
+        program->context->sd->loom_krea_activation != nullptr ||
+        activation_callback == nullptr) {
+        return SD_LOOM_STATUS_INVALID_ARGUMENT;
+    }
+
+    uint32_t step_count = static_cast<uint32_t>(params->image.image.sigma_count - 1);
+    size_t transition_words = params->image.model_block_operator_count == 0
+                                  ? 0
+                                  : params->image.model_block_operator_count *
+                                        ((static_cast<size_t>(step_count) + 63) / 64);
+    if (transition_mask_capacity != transition_words ||
+        (transition_words > 0 && transition_masks == nullptr)) {
+        return SD_LOOM_STATUS_INVALID_ARGUMENT;
+    }
+
+    KreaActivationTopology topology;
+    if (program->context->sd->diffusion_model == nullptr ||
+        !program->context->sd->diffusion_model->krea_activation_topology(&topology)) {
+        return SD_LOOM_STATUS_UNSUPPORTED;
+    }
+
+    try {
+        KreaActivationRequest request;
+        request.maximum_host_bytes = params->maximum_host_bytes;
+        request.maximum_device_bytes = params->maximum_device_bytes;
+        request.maximum_applications = params->maximum_applications;
+        request.captures.reserve(params->capture_count);
+        uint32_t prior_capture = 0;
+        for (size_t index = 0; index < params->capture_count; ++index) {
+            const auto& source = params->captures[index];
+            const auto* site = sd_loom_krea_site_v6(topology, source.site);
+            uint64_t selected_rows = 0;
+            uint64_t reaches = 0;
+            KreaActivationCaptureControl capture;
+            if (site == nullptr || (index > 0 && prior_capture >= source.capture_index) ||
+                source.branch < SD_LOOM_KREA_CONDITIONAL_V6 ||
+                source.branch > SD_LOOM_KREA_UNCONDITIONAL_V6 ||
+                (site->branch_mask & (1u << (source.branch - 1))) == 0 ||
+                source.retention < SD_LOOM_KREA_CAPTURE_DIGEST_V6 ||
+                source.retention > SD_LOOM_KREA_CAPTURE_DEVICE_SNAPSHOT_V6 ||
+                source.maximum_elements == 0 ||
+                source.maximum_elements > 16ull * 1024 * 1024 ||
+                source.maximum_host_bytes > 64ull * 1024 * 1024 ||
+                source.maximum_device_bytes > 64ull * 1024 * 1024 ||
+                !sd_loom_krea_selection_v6(source.tokens,
+                                           site->domain_mask,
+                                           &capture.selection,
+                                           &selected_rows) ||
+                !sd_loom_krea_boundary_v6(source.boundary,
+                                          site->boundary_mask,
+                                          step_count,
+                                          &capture.boundary,
+                                          &reaches)) {
+                return SD_LOOM_STATUS_INVALID_ARGUMENT;
+            }
+            if (selected_rows > 0 &&
+                (selected_rows > std::numeric_limits<uint64_t>::max() / site->width ||
+                 selected_rows * site->width > source.maximum_elements)) {
+                return SD_LOOM_STATUS_INVALID_ARGUMENT;
+            }
+            capture.capture_index = source.capture_index;
+            capture.site = source.site;
+            capture.branch = static_cast<KreaActivationBranch>(source.branch);
+            capture.retention = static_cast<KreaActivationRetention>(source.retention);
+            capture.maximum_elements = source.maximum_elements;
+            capture.maximum_host_bytes = source.maximum_host_bytes;
+            capture.maximum_device_bytes = source.maximum_device_bytes;
+            request.captures.push_back(std::move(capture));
+            prior_capture = source.capture_index;
+        }
+
+        request.operations.reserve(params->operation_count);
+        std::set<std::pair<uint32_t, uint32_t>> resident_inputs;
+        uint32_t prior_operation = 0;
+        for (size_t index = 0; index < params->operation_count; ++index) {
+            const auto& source = params->operations[index];
+            const auto* site = sd_loom_krea_site_v6(topology, source.site);
+            uint64_t selected_rows = 0;
+            uint64_t reaches = 0;
+            KreaActivationOperationControl operation;
+            if (site == nullptr || (index > 0 && prior_operation >= source.operation_index) ||
+                source.branch < SD_LOOM_KREA_CONDITIONAL_V6 ||
+                source.branch > SD_LOOM_KREA_UNCONDITIONAL_V6 ||
+                (site->branch_mask & (1u << (source.branch - 1))) == 0 ||
+                source.operation < SD_LOOM_KREA_DONOR_TRANSPLANT_V6 ||
+                source.operation > SD_LOOM_KREA_ONE_SIDED_REMOVAL_V6 ||
+                !std::isfinite(source.strength) ||
+                ((source.operation == SD_LOOM_KREA_SCALED_VECTOR_ADD_V6 ||
+                  source.operation == SD_LOOM_KREA_SCALED_VECTOR_SUBTRACT_V6)
+                     ? source.strength < -64.f || source.strength > 64.f
+                     : source.strength < 0.f || source.strength > 1.f) ||
+                !sd_loom_krea_selection_v6(source.tokens,
+                                           site->domain_mask,
+                                           &operation.selection,
+                                           &selected_rows) ||
+                !sd_loom_krea_boundary_v6(source.boundary,
+                                          site->boundary_mask,
+                                          step_count,
+                                          &operation.boundary,
+                                          &reaches)) {
+                return SD_LOOM_STATUS_INVALID_ARGUMENT;
+            }
+            operation.operation_index = source.operation_index;
+            operation.site = source.site;
+            operation.branch = static_cast<KreaActivationBranch>(source.branch);
+            operation.operation = static_cast<KreaActivationOperatorKind>(source.operation);
+            operation.vector = source.vector;
+            operation.strength = source.strength;
+
+            if (source.input_source == SD_LOOM_KREA_RESIDENT_INPUT_V6) {
+                KreaActivationResidentInputDescription description;
+                if (source.resident_input.reserved != 0 ||
+                    !program->context->sd->diffusion_model->krea_activation_describe(
+                        sd_loom_krea_handle_v6(source.resident_input),
+                        &description) ||
+                    description.site != source.site ||
+                    ((source.operation == SD_LOOM_KREA_DONOR_TRANSPLANT_V6 &&
+                      description.representation != SD_LOOM_KREA_DONOR_F32_ROWS_V6) ||
+                     ((source.operation == SD_LOOM_KREA_SCALED_VECTOR_ADD_V6 ||
+                       source.operation == SD_LOOM_KREA_SCALED_VECTOR_SUBTRACT_V6) &&
+                      (description.representation != SD_LOOM_KREA_VECTOR_F32_ROWS_V6 ||
+                       source.vector >= description.rows)) ||
+                     ((source.operation == SD_LOOM_KREA_PROJECTION_REMOVAL_V6 ||
+                       source.operation == SD_LOOM_KREA_ONE_SIDED_REMOVAL_V6) &&
+                      description.representation != SD_LOOM_KREA_ORTHONORMAL_F32_ROWS_V6)) ||
+                    (source.operation == SD_LOOM_KREA_DONOR_TRANSPLANT_V6 &&
+                     selected_rows > 0 && description.rows != selected_rows)) {
+                    return SD_LOOM_STATUS_INVALID_ARGUMENT;
+                }
+                operation.resident = sd_loom_krea_handle_v6(source.resident_input);
+                auto identity = std::make_pair(source.resident_input.generation,
+                                               source.resident_input.slot);
+                if (resident_inputs.insert(identity).second) {
+                    if (request.resident_device_bytes > request.maximum_device_bytes ||
+                        description.bytes >
+                            request.maximum_device_bytes - request.resident_device_bytes) {
+                        return SD_LOOM_STATUS_INVALID_ARGUMENT;
+                    }
+                    request.resident_device_bytes += description.bytes;
+                }
+            } else if (source.input_source == SD_LOOM_KREA_CAPTURE_INPUT_V6) {
+                const sd_loom_krea_capture_v6_t* capture = nullptr;
+                for (size_t capture_index = 0;
+                     capture_index < params->capture_count;
+                     ++capture_index) {
+                    if (params->captures[capture_index].capture_index ==
+                        source.capture_input) {
+                        capture = &params->captures[capture_index];
+                        break;
+                    }
+                }
+                if (capture == nullptr ||
+                    source.operation != SD_LOOM_KREA_DONOR_TRANSPLANT_V6 ||
+                    capture->site != source.site || capture->branch != source.branch ||
+                    capture->retention != SD_LOOM_KREA_CAPTURE_DEVICE_SNAPSHOT_V6 ||
+                    !sd_loom_equal_krea_selection_v6(capture->tokens, source.tokens) ||
+                    !sd_loom_equal_krea_boundary_v6(capture->boundary, source.boundary) ||
+                    (capture->boundary.boundary == SD_LOOM_KREA_TRANSITION_V6 &&
+                     (capture->boundary.step_selection != SD_LOOM_STEP_EXACT_V4 ||
+                      capture->boundary.step_count != 1))) {
+                    return SD_LOOM_STATUS_INVALID_ARGUMENT;
+                }
+                operation.source_is_capture = true;
+                operation.capture_source = source.capture_input;
+            } else {
+                return SD_LOOM_STATUS_INVALID_ARGUMENT;
+            }
+            request.operations.push_back(std::move(operation));
+            prior_operation = source.operation_index;
+        }
+
+        sd_loom_krea_callback_state_v6_t callback_state{
+            activation_callback,
+            activation_callback_data,
+        };
+        request.callback = sd_loom_krea_callback_v6;
+        request.callback_data = &callback_state;
+        request.peak_device_bytes = request.resident_device_bytes;
+        program->context->sd->loom_krea_activation = &request;
+
+        int32_t status;
+        if (params->image.model_block_operator_count > 0) {
+            status = sd_loom_program_generate_image_v5(
+                program,
+                &params->image,
+                condition_callback,
+                condition_callback_data,
+                step_callback,
+                step_callback_data,
+                snapshot_values,
+                snapshot_capacity,
+                model_block_results,
+                model_block_capacity,
+                transition_masks,
+                transition_mask_capacity,
+                &result_out->image);
+        } else {
+            status = sd_loom_program_generate_image_v3(
+                program,
+                &params->image.image,
+                condition_callback,
+                condition_callback_data,
+                step_callback,
+                step_callback_data,
+                snapshot_values,
+                snapshot_capacity,
+                &result_out->image.image);
+            result_out->image.model_block_application_count = 0;
+            result_out->image.transition_words_per_operator = 0;
+            result_out->image.controls_cleared = 1;
+        }
+
+        program->context->sd->loom_krea_activation = nullptr;
+        bool cleaned = program->context->sd->diffusion_model->krea_activation_finish_request();
+        result_out->activation_controls_cleared = cleaned ? 1 : 0;
+        for (size_t index = 0; index < request.captures.size(); ++index) {
+            capture_results[index] = {
+                request.captures[index].capture_index,
+                request.captures[index].reached,
+                request.captures[index].elements,
+            };
+        }
+        for (size_t index = 0; index < request.operations.size(); ++index) {
+            application_results[index] = {
+                request.operations[index].operation_index,
+                request.operations[index].reached,
+                request.operations[index].applied,
+                request.operations[index].unchanged,
+            };
+        }
+        result_out->capture_count = request.captures.size();
+        result_out->operation_count = request.operations.size();
+        result_out->peak_host_bytes = request.peak_host_bytes;
+        result_out->peak_device_bytes = request.peak_device_bytes;
+        if (!cleaned || request.execution_failed) {
+            return SD_LOOM_STATUS_NATIVE_ERROR;
+        }
+        if (request.callback_failed) {
+            return SD_LOOM_STATUS_CALLBACK_ERROR;
+        }
+        return status;
+    } catch (...) {
+        program->context->sd->loom_krea_activation = nullptr;
+        if (program->context->sd->diffusion_model != nullptr) {
+            program->context->sd->diffusion_model->krea_activation_finish_request();
+        }
+        return SD_LOOM_STATUS_NATIVE_ERROR;
+    }
+}
+
 int32_t sd_loom_program_describe_v3(const sd_loom_program_v3_t* program,
                                     sd_loom_value_handle_v3_t handle,
                                     sd_loom_value_descriptor_v3_t* descriptor_out) {
