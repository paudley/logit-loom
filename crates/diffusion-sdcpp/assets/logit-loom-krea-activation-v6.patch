+static bool sd_loom_krea_callback_v6(void* opaque,
+                                     KreaActivationEventKind kind,
+                                     uint32_t index,
+                                     uint64_t reach,
+                                     const float* values,
+                                     size_t elements) {
+    auto* state = static_cast<sd_loom_krea_callback_state_v6_t*>(opaque);
+    return state != nullptr && state->callback != nullptr &&
+           state->callback(static_cast<sd_loom_krea_event_v6_t>(kind),
+                           index,
+                           reach,
+                           values,
+                           elements,
+                           state->data) == SD_LOOM_CALLBACK_CONTINUE;
+}
