@@ -589,6 +593,415 @@ namespace Krea2 {
         }
     };
 
+    struct KreaActivationResidentTensor {
+        KreaActivationResidentInputDescription description;
+        ggml_context* context            = nullptr;
+        ggml_backend_buffer_t buffer      = nullptr;
+        ggml_tensor* tensor               = nullptr;
+
+        ~KreaActivationResidentTensor() {
+            if (buffer != nullptr) {
+                ggml_backend_buffer_free(buffer);
+            }
+            if (context != nullptr) {
+                ggml_free(context);
+            }
+        }
+
+        KreaActivationResidentTensor() = default;
+        KreaActivationResidentTensor(const KreaActivationResidentTensor&) = delete;
+        KreaActivationResidentTensor& operator=(const KreaActivationResidentTensor&) = delete;
+    };
+
+    struct KreaActivationPendingEvent {
+        KreaActivationEventKind kind = KREA_ACTIVATION_CAPTURE_EVENT;
+        uint32_t index               = 0;
+        uint64_t reach               = 0;
+        ggml_tensor* tensor           = nullptr;
+        KreaActivationOperationControl* operation = nullptr;
+    };
+
+    class KreaActivationGraph {
+    public:
+        using ResidentLookup = std::function<ggml_tensor*(KreaActivationResidentHandle)>;
+
+        KreaActivationGraph(GGMLRunnerContext* context,
+                            KreaActivationRequest* request,
+                            uint32_t transition,
+                            KreaActivationBranch branch,
+                            ResidentLookup resident_lookup,
+                            std::vector<KreaActivationPendingEvent>* events)
+            : context_(context),
+              request_(request),
+              transition_(transition),
+              branch_(branch),
+              resident_lookup_(std::move(resident_lookup)),
+              events_(events) {}
+
+        ggml_tensor* apply(uint32_t site,
+                           KreaActivationBoundaryKind site_boundary,
+                           ggml_tensor* tensor,
+                           int64_t text_start,
+                           int64_t text_length,
+                           int64_t image_start,
+                           int64_t image_length,
+                           int64_t reference_start,
+                           int64_t reference_length) {
+            if (request_ == nullptr || tensor == nullptr || request_->execution_failed) {
+                return tensor;
+            }
+            if (tensor->type != GGML_TYPE_F32 || tensor->ne[2] != 1 || tensor->ne[3] != 1) {
+                request_->execution_failed = true;
+                return tensor;
+            }
+
+            std::unordered_map<uint32_t, ggml_tensor*> captures;
+            uint64_t snapshot_device_bytes = 0;
+            for (auto& capture : request_->captures) {
+                if (capture.site != site || capture.branch != branch_ ||
+                    !boundary_active(capture.boundary, site_boundary)) {
+                    continue;
+                }
+                ggml_tensor* selected = select(tensor,
+                                               capture.selection,
+                                               text_start,
+                                               text_length,
+                                               image_start,
+                                               image_length,
+                                               reference_start,
+                                               reference_length);
+                if (selected == nullptr) {
+                    request_->execution_failed = true;
+                    return tensor;
+                }
+                captures[capture.capture_index] = selected;
+                if (capture.retention == KREA_ACTIVATION_DEVICE_SNAPSHOT) {
+                    uint64_t bytes = static_cast<uint64_t>(ggml_nbytes(selected));
+                    if (snapshot_device_bytes >
+                        std::numeric_limits<uint64_t>::max() - bytes) {
+                        request_->execution_failed = true;
+                        return tensor;
+                    }
+                    snapshot_device_bytes += bytes;
+                }
+                if (records_boundary(capture.boundary)) {
+                    ++capture.reached;
+                    capture.elements += static_cast<uint64_t>(ggml_nelements(selected));
+                    queue_event(KREA_ACTIVATION_CAPTURE_EVENT,
+                                capture.capture_index,
+                                capture.reached,
+                                selected,
+                                nullptr);
+                }
+            }
+            if (request_->resident_device_bytes > request_->maximum_device_bytes ||
+                snapshot_device_bytes >
+                    request_->maximum_device_bytes - request_->resident_device_bytes) {
+                request_->execution_failed = true;
+                return tensor;
+            }
+            request_->peak_device_bytes = std::max(
+                request_->peak_device_bytes,
+                request_->resident_device_bytes + snapshot_device_bytes);
+
+            ggml_tensor* current = tensor;
+            for (auto& operation : request_->operations) {
+                if (operation.site != site || operation.branch != branch_ ||
+                    !boundary_active(operation.boundary, site_boundary)) {
+                    continue;
+                }
+                ggml_tensor* before = select(current,
+                                             operation.selection,
+                                             text_start,
+                                             text_length,
+                                             image_start,
+                                             image_length,
+                                             reference_start,
+                                             reference_length);
+                if (before == nullptr) {
+                    request_->execution_failed = true;
+                    return tensor;
+                }
+                ggml_tensor* source = nullptr;
+                if (operation.source_is_capture) {
+                    auto found = captures.find(operation.capture_source);
+                    if (found != captures.end()) {
+                        source = found->second;
+                    }
+                } else {
+                    source = resident_lookup_(operation.resident);
+                }
+                if (source == nullptr || source->type != GGML_TYPE_F32 ||
+                    source->ne[0] != before->ne[0]) {
+                    request_->execution_failed = true;
+                    return tensor;
+                }
+
+                ggml_tensor* after = transform(before, source, operation);
+                if (after == nullptr) {
+                    request_->execution_failed = true;
+                    return tensor;
+                }
+                current = splice(current,
+                                 after,
+                                 operation.selection,
+                                 text_start,
+                                 text_length,
+                                 image_start,
+                                 image_length,
+                                 reference_start,
+                                 reference_length);
+                if (current == nullptr) {
+                    request_->execution_failed = true;
+                    return tensor;
+                }
+                if (records_boundary(operation.boundary)) {
+                    if (request_->applications >= request_->maximum_applications) {
+                        request_->execution_failed = true;
+                        return tensor;
+                    }
+                    ++request_->applications;
+                    ++operation.reached;
+                    ++operation.applied;
+                    queue_event(KREA_ACTIVATION_APPLICATION_BEFORE_EVENT,
+                                operation.operation_index,
+                                operation.reached,
+                                before,
+                                &operation);
+                    queue_event(KREA_ACTIVATION_APPLICATION_AFTER_EVENT,
+                                operation.operation_index,
+                                operation.reached,
+                                after,
+                                &operation);
+                }
+            }
+            return current;
+        }
+
+    private:
+        GGMLRunnerContext* context_ = nullptr;
+        KreaActivationRequest* request_ = nullptr;
+        uint32_t transition_ = 0;
+        KreaActivationBranch branch_ = KREA_ACTIVATION_CONDITIONAL;
+        ResidentLookup resident_lookup_;
+        std::vector<KreaActivationPendingEvent>* events_ = nullptr;
+
+        bool boundary_active(const KreaActivationBoundary& boundary,
+                             KreaActivationBoundaryKind site_boundary) const {
+            if (boundary.kind != site_boundary) {
+                return false;
+            }
+            return site_boundary == KREA_ACTIVATION_PRE_DENOISER ||
+                   boundary.selects(transition_);
+        }
+
+        bool records_boundary(const KreaActivationBoundary& boundary) const {
+            return boundary.kind == KREA_ACTIVATION_TRANSITION || transition_ == 0;
+        }
+
+        bool domain(const KreaActivationSelection& selection,
+                    int64_t text_start,
+                    int64_t text_length,
+                    int64_t image_start,
+                    int64_t image_length,
+                    int64_t reference_start,
+                    int64_t reference_length,
+                    int64_t* start,
+                    int64_t* length) const {
+            switch (selection.domain) {
+                case KREA_ACTIVATION_TEXT:
+                    *start  = text_start;
+                    *length = text_length;
+                    return true;
+                case KREA_ACTIVATION_IMAGE:
+                    *start  = image_start;
+                    *length = image_length;
+                    return true;
+                case KREA_ACTIVATION_REFERENCE:
+                    *start  = reference_start;
+                    *length = reference_length;
+                    return true;
+            }
+            return false;
+        }
+
+        ggml_tensor* select(ggml_tensor* tensor,
+                            const KreaActivationSelection& selection,
+                            int64_t text_start,
+                            int64_t text_length,
+                            int64_t image_start,
+                            int64_t image_length,
+                            int64_t reference_start,
+                            int64_t reference_length) const {
+            int64_t start  = 0;
+            int64_t length = 0;
+            if (!domain(selection,
+                        text_start,
+                        text_length,
+                        image_start,
+                        image_length,
+                        reference_start,
+                        reference_length,
+                        &start,
+                        &length) ||
+                start < 0 || length <= 0 || start + length > tensor->ne[1]) {
+                return nullptr;
+            }
+            auto view = [&](int64_t row_start, int64_t row_count) {
+                return ggml_view_2d(context_->ggml_ctx,
+                                    tensor,
+                                    tensor->ne[0],
+                                    row_count,
+                                    tensor->nb[1],
+                                    static_cast<size_t>(row_start) * tensor->nb[1]);
+            };
+            if (selection.all) {
+                return ggml_cont(context_->ggml_ctx, view(start, length));
+            }
+            ggml_tensor* selected = nullptr;
+            uint32_t prior_end = 0;
+            for (const auto& range : selection.ranges) {
+                if (range.start >= range.end || range.end > static_cast<uint64_t>(length) ||
+                    range.start < prior_end) {
+                    return nullptr;
+                }
+                ggml_tensor* part = ggml_cont(context_->ggml_ctx,
+                                              view(start + range.start,
+                                                   range.end - range.start));
+                selected = selected == nullptr
+                               ? part
+                               : ggml_concat(context_->ggml_ctx, selected, part, 1);
+                prior_end = range.end;
+            }
+            return selected;
+        }
+
+        ggml_tensor* transform(ggml_tensor* target,
+                               ggml_tensor* source,
+                               const KreaActivationOperationControl& operation) const {
+            if (operation.strength == 0.f) {
+                return target;
+            }
+            switch (operation.operation) {
+                case KREA_ACTIVATION_DONOR_TRANSPLANT:
+                    if (source->ne[1] != target->ne[1]) {
+                        return nullptr;
+                    }
+                    if (operation.strength == 1.f) {
+                        return source;
+                    }
+                    return ggml_add(
+                        context_->ggml_ctx,
+                        ggml_scale(context_->ggml_ctx, target, 1.f - operation.strength),
+                        ggml_scale(context_->ggml_ctx, source, operation.strength));
+                case KREA_ACTIVATION_SCALED_VECTOR_ADD:
+                case KREA_ACTIVATION_SCALED_VECTOR_SUBTRACT: {
+                    if (operation.vector >= static_cast<uint64_t>(source->ne[1])) {
+                        return nullptr;
+                    }
+                    ggml_tensor* vector = ggml_view_2d(
+                        context_->ggml_ctx,
+                        source,
+                        source->ne[0],
+                        1,
+                        source->nb[1],
+                        static_cast<size_t>(operation.vector) * source->nb[1]);
+                    float strength = operation.operation == KREA_ACTIVATION_SCALED_VECTOR_SUBTRACT
+                                         ? -operation.strength
+                                         : operation.strength;
+                    return ggml_add(context_->ggml_ctx,
+                                    target,
+                                    ggml_scale(context_->ggml_ctx, vector, strength));
+                }
+                case KREA_ACTIVATION_PROJECTION_REMOVAL:
+                case KREA_ACTIVATION_ONE_SIDED_REMOVAL: {
+                    ggml_tensor* coefficients = ggml_mul_mat(context_->ggml_ctx,
+                                                             source,
+                                                             target);
+                    if (operation.operation == KREA_ACTIVATION_ONE_SIDED_REMOVAL) {
+                        coefficients = ggml_clamp(context_->ggml_ctx,
+                                                  coefficients,
+                                                  0.f,
+                                                  std::numeric_limits<float>::max());
+                    }
+                    ggml_tensor* basis_transpose = ggml_cont(
+                        context_->ggml_ctx,
+                        ggml_transpose(context_->ggml_ctx, source));
+                    ggml_tensor* projection = ggml_mul_mat(context_->ggml_ctx,
+                                                           basis_transpose,
+                                                           coefficients);
+                    return ggml_sub(context_->ggml_ctx,
+                                    target,
+                                    ggml_scale(context_->ggml_ctx,
