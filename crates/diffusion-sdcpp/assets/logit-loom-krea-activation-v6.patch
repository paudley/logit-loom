+static bool sd_loom_krea_selection_v6(
+    const sd_loom_krea_token_selection_v6_t& source,
+    uint32_t domain_mask,
+    KreaActivationSelection* destination,
+    uint64_t* selected_rows) {
+    if (destination == nullptr || selected_rows == nullptr ||
+        source.domain < SD_LOOM_KREA_TEXT_V6 ||
+        source.domain > SD_LOOM_KREA_REFERENCE_V6 ||
+        (domain_mask & (1u << (source.domain - 1))) == 0) {
+        return false;
+    }
+    *destination = {};
+    destination->domain = static_cast<KreaActivationTokenDomain>(source.domain);
+    *selected_rows = 0;
+    if (source.selection == SD_LOOM_KREA_ALL_TOKENS_V6) {
+        if (source.ranges != nullptr || source.range_count != 0) {
+            return false;
+        }
+        destination->all = true;
+        return true;
+    }
+    if (source.selection != SD_LOOM_KREA_TOKEN_RANGES_V6 ||
+        source.ranges == nullptr || source.range_count == 0 ||
+        source.range_count > 256) {
+        return false;
+    }
+    destination->ranges.reserve(source.range_count);
+    uint32_t prior_end = 0;
+    for (size_t index = 0; index < source.range_count; ++index) {
+        const auto& range = source.ranges[index];
+        if (range.start >= range.end || (index > 0 && prior_end > range.start)) {
+            return false;
+        }
+        uint64_t length = static_cast<uint64_t>(range.end) - range.start;
+        if (*selected_rows > std::numeric_limits<uint64_t>::max() - length) {
+            return false;
+        }
+        *selected_rows += length;
+        destination->ranges.push_back({range.start, range.end});
+        prior_end = range.end;
+    }
+    return true;
+}
+
+static bool sd_loom_krea_boundary_v6(
+    const sd_loom_krea_boundary_selection_v6_t& source,
+    uint32_t boundary_mask,
+    uint32_t step_count,
+    KreaActivationBoundary* destination,
+    uint64_t* reaches) {
+    if (destination == nullptr || reaches == nullptr ||
+        source.boundary < SD_LOOM_KREA_PRE_DENOISER_V6 ||
+        source.boundary > SD_LOOM_KREA_TRANSITION_V6 ||
+        (boundary_mask & (1u << (source.boundary - 1))) == 0) {
+        return false;
+    }
+    *destination = {};
+    destination->kind = static_cast<KreaActivationBoundaryKind>(source.boundary);
+    if (source.boundary == SD_LOOM_KREA_PRE_DENOISER_V6) {
+        if (source.step_selection != SD_LOOM_STEP_ALL_V4 ||
+            source.steps != nullptr || source.step_count != 0) {
+            return false;
+        }
+        destination->all = true;
+        *reaches = 1;
+        return true;
+    }
+    if (source.step_selection == SD_LOOM_STEP_ALL_V4) {
+        if (source.steps != nullptr || source.step_count != 0) {
+            return false;
+        }
+        destination->all = true;
+        *reaches = step_count;
+        return true;
+    }
+    if (source.step_selection != SD_LOOM_STEP_EXACT_V4 ||
+        source.steps == nullptr || source.step_count == 0 ||
+        source.step_count > step_count) {
+        return false;
+    }
+    destination->steps.reserve(source.step_count);
+    uint32_t prior = 0;
+    for (size_t index = 0; index < source.step_count; ++index) {
+        uint32_t step = source.steps[index];
+        if (step >= step_count || (index > 0 && prior >= step)) {
+            return false;
+        }
+        destination->steps.push_back(step);
+        prior = step;
+    }
+    *reaches = source.step_count;
+    return true;
+}
+
+static bool sd_loom_equal_krea_selection_v6(
+    const sd_loom_krea_token_selection_v6_t& left,
+    const sd_loom_krea_token_selection_v6_t& right) {
+    if (left.domain != right.domain || left.selection != right.selection ||
+        left.range_count != right.range_count) {
+        return false;
+    }
+    for (size_t index = 0; index < left.range_count; ++index) {
+        if (left.ranges[index].start != right.ranges[index].start ||
+            left.ranges[index].end != right.ranges[index].end) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool sd_loom_equal_krea_boundary_v6(
+    const sd_loom_krea_boundary_selection_v6_t& left,
+    const sd_loom_krea_boundary_selection_v6_t& right) {
+    if (left.boundary != right.boundary ||
+        left.step_selection != right.step_selection ||
+        left.step_count != right.step_count) {
+        return false;
+    }
+    for (size_t index = 0; index < left.step_count; ++index) {
+        if (left.steps[index] != right.steps[index]) {
+            return false;
+        }
+    }
+    return true;
+}
