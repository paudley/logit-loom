+    const KreaActivationResidentInputDescription& source,
+    sd_loom_krea_input_description_v6_t* destination) {
+    *destination = {
+        SD_LOOM_KREA_ACTIVATION_ABI_VERSION,
+        sd_loom_krea_handle_v6(source.handle),
+        source.site,
+        source.width,
+        source.rows,
+        static_cast<sd_loom_krea_input_representation_v6_t>(source.representation),
