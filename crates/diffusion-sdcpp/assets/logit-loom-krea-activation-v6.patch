+int32_t sd_loom_krea_topology_v6(
+    const sd_ctx_t* sd_ctx,
+    sd_loom_krea_topology_v6_t* topology_out,
+    sd_loom_krea_site_v6_t* sites,
+    size_t site_capacity) {
+    if (topology_out != nullptr) {
+        *topology_out = {SD_LOOM_KREA_ACTIVATION_ABI_VERSION, 0, 0, 0};
+    }
+    if (sd_ctx == nullptr || sd_ctx->sd == nullptr || topology_out == nullptr ||
+        (sites == nullptr && site_capacity != 0)) {
+        return SD_LOOM_STATUS_INVALID_ARGUMENT;
+    }
+    try {
+        KreaActivationTopology topology;
+        if (sd_ctx->sd->diffusion_model == nullptr ||
+            !sd_ctx->sd->diffusion_model->krea_activation_topology(&topology)) {
+            return SD_LOOM_STATUS_UNSUPPORTED;
+        }
+        topology_out->conditioner_layers = topology.conditioner_layers;
+        topology_out->transformer_blocks = topology.transformer_blocks;
+        topology_out->site_count = topology.sites.size();
+        if (sites == nullptr) {
+            return site_capacity == 0 ? SD_LOOM_STATUS_OK
+                                      : SD_LOOM_STATUS_INVALID_ARGUMENT;
+        }
+        if (site_capacity != topology.sites.size()) {
+            return SD_LOOM_STATUS_INVALID_ARGUMENT;
+        }
+        for (size_t index = 0; index < topology.sites.size(); ++index) {
+            const auto& source = topology.sites[index];
+            sites[index] = {
+                source.site,
+                static_cast<sd_loom_krea_site_kind_v6_t>(source.kind),
+                source.index,
+                source.width,
+                source.boundary_mask,
+                source.domain_mask,
+                source.branch_mask,
+            };
+        }
+        return SD_LOOM_STATUS_OK;
+    } catch (...) {
+        return SD_LOOM_STATUS_NATIVE_ERROR;
+    }
+}
