+                    request.execution_failed = true;
+                    continue;
+                }
+                request.peak_host_bytes = std::max(
+                    request.peak_host_bytes,
+                    retained_host_bytes + event_bytes * copies);
+                std::vector<float> values(static_cast<size_t>(ggml_nelements(event.tensor)));
