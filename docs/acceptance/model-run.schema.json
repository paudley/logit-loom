{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/paudley/logit-loom/blob/main/docs/acceptance/model-run.schema.json",
  "title": "Logit Loom model-backed acceptance report",
  "description": "Path-free mechanical acceptance evidence. Model inputs, outputs, weights, and caller-local paths are deliberately absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity_domain",
    "profile_id",
    "modality",
    "adapter",
    "experiment",
    "status",
    "catalog_sha256",
    "artifacts",
    "runtime",
    "runs",
    "assertions",
    "blockers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "identity_domain": {
      "const": "logit-loom-model-acceptance-report-v1"
    },
    "profile_id": {
      "$ref": "#/$defs/identifier"
    },
    "modality": {
      "enum": [
        "text",
        "image"
      ]
    },
    "adapter": {
      "$ref": "#/$defs/identifier"
    },
    "experiment": {
      "$ref": "#/$defs/identifier"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "blocked"
      ]
    },
    "catalog_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "measurements": {
      "$ref": "#/$defs/measurements"
    },
    "blockers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/blocker"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "bounded_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "repository",
        "revision",
        "artifact_path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/identifier"
        },
        "repository": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifact_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_build_identity",
        "backend",
        "devices",
        "accelerator_required",
        "cpu_fallback"
      ],
      "properties": {
        "adapter_build_identity": {
          "$ref": "#/$defs/digest"
        },
        "backend": {
          "$ref": "#/$defs/bounded_text"
        },
        "parameter_backend": {
          "$ref": "#/$defs/bounded_text"
        },
        "devices": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/bounded_text"
          }
        },
        "accelerator_required": {
          "const": true
        },
        "cpu_fallback": {
          "const": false
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "plan_identity",
        "receipt_identity",
        "output_identity",
        "completed_steps"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/identifier"
        },
        "plan_identity": {
          "$ref": "#/$defs/digest"
        },
        "receipt_identity": {
          "$ref": "#/$defs/digest"
        },
        "output_identity": {
          "$ref": "#/$defs/digest"
        },
        "completed_steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not-run"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/bounded_text"
        }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "peak_host_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "peak_device_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "step_latency_milliseconds": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "detail"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/identifier"
        },
        "detail": {
          "$ref": "#/$defs/bounded_text"
        }
      }
    }
  }
}
