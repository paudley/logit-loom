diff --git src/pipeline/image.cpp src/pipeline/image.cpp
index 4dfa5eb..0b82156 100644
--- src/pipeline/image.cpp
+++ src/pipeline/image.cpp
@@ -886,6 +886,30 @@ namespace sd::pipeline {
 
         const RefImageParams ref_image_params = sd->resolve_ref_image_params(sd_img_gen_params->ref_image_args);
 
+        // Logit Loom: Krea2 reference conditioning implements the community
+        // edit-LoRA protocol (Krea2OstrisEdit / krea2 identity edit). That protocol
+        // encodes every reference twice: into the Qwen3-VL multimodal context
+        // (pass_to_vlm) and as timestep-zero latent tokens appended to the DiT
+        // sequence (pass_to_dit). A text-only Qwen3-VL artifact silently drops the
+        // whole multimodal half, and the base Krea2 model was never trained on
+        // appended reference tokens, so this configuration deterministically
+        // degrades every generation into a per-latent-cell mosaic instead of
+        // conditioning it. Fail loudly instead of returning corrupted images.
+        if (sd_version_is_krea2(sd->version) &&
+            sd_img_gen_params->ref_images_count > 0 &&
+            ref_image_params.pass_to_vlm &&
+            sd->cond_stage_model != nullptr &&
+            !sd->cond_stage_model->supports_vision_references()) {
+            LOG_ERROR(
+                "Krea2 reference images require the community edit-LoRA protocol: the active "
+                "reference preset passes references to the Qwen3-VL vision tower, but the loaded "
+                "text encoder has no vision weights, and the base Krea2 model cannot consume "
+                "appended reference tokens. This configuration corrupts the output into a "
+                "per-latent-cell mosaic. Deploy the vision-capable Qwen3-VL text encoder together "
+                "with a Krea2 edit LoRA, or withhold the reference images.");
+            return false;
+        }
+
         ImageVaeAxesGuard axes_guard(sd, sd_img_gen_params, request);
 
         SamplePlan plan(sd, sd_img_gen_params, request);
