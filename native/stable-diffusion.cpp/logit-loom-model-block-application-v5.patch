+static bool sd_loom_valid_model_block_steps_v5(
+    const sd_loom_model_block_operator_v5_t& operator_params,
+    uint32_t step_count) {
+    if (operator_params.step_selection == SD_LOOM_STEP_ALL_V4) {
+        return operator_params.steps == nullptr &&
+               operator_params.step_count == 0;
+    }
+    if (operator_params.step_selection != SD_LOOM_STEP_EXACT_V4 ||
+        operator_params.steps == nullptr ||
+        operator_params.step_count == 0 ||
+        operator_params.step_count > step_count) {
+        return false;
+    }
+    for (size_t index = 0; index < operator_params.step_count; ++index) {
+        if (operator_params.steps[index] >= step_count ||
+            (index > 0 &&
+             operator_params.steps[index - 1] >= operator_params.steps[index])) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool sd_loom_model_block_operator_selects_v5(
+    const sd_loom_model_block_operator_v5_t& operator_params,
+    uint32_t step) {
+    if (operator_params.step_selection == SD_LOOM_STEP_ALL_V4) {
+        return true;
+    }
+    return std::binary_search(operator_params.steps,
+                              operator_params.steps + operator_params.step_count,
+                              step);
+}
+
+int32_t sd_loom_program_generate_image_v5(
+    sd_loom_program_v3_t* program,
+    const sd_loom_program_image_params_v5_t* params,
+    sd_loom_condition_cb_v1_t condition_callback,
+    void* condition_callback_data,
+    sd_loom_step_cb_v1_t step_callback,
+    void* step_callback_data,
+    sd_loom_value_handle_v3_t* snapshot_values,
+    size_t snapshot_capacity,
+    sd_loom_model_block_application_v5_t* application_results,
+    size_t application_capacity,
+    uint64_t* transition_masks,
+    size_t transition_mask_capacity,
+    sd_loom_program_image_result_v5_t* result_out) {
+    if (result_out != nullptr) {
+        *result_out = {
+            SD_LOOM_MODEL_BLOCK_APPLICATION_ABI_VERSION,
+            {
+                SD_LOOM_PROGRAM_ABI_VERSION,
+                sd_loom_empty_handle_v3(),
+                sd_loom_empty_handle_v3(),
+                0,
+            },
+            0,
+            0,
+            0,
+        };
+    }
+    if (application_results != nullptr) {
+        for (size_t application = 0;
+             application < application_capacity;
+             ++application) {
+            application_results[application] = {};
+        }
+    }
+    if (transition_masks != nullptr) {
+        std::fill(transition_masks,
+                  transition_masks + transition_mask_capacity,
+                  uint64_t{0});
+    }
+    if (!sd_loom_program_live_v3(program) ||
+        params == nullptr ||
+        result_out == nullptr ||
+        params->abi_version != SD_LOOM_MODEL_BLOCK_APPLICATION_ABI_VERSION ||
+        params->image.abi_version != SD_LOOM_PROGRAM_ABI_VERSION ||
+        params->image.sigma_count < 2 ||
+        params->image.sigma_count > 4097 ||
+        params->model_block_operator_count == 0 ||
+        params->model_block_operator_count > 64 ||
+        params->model_block_operators == nullptr ||
+        application_results == nullptr ||
+        application_capacity != params->model_block_operator_count ||
+        !program->context->sd->loom_model_block_controls.empty()) {
+        return SD_LOOM_STATUS_INVALID_ARGUMENT;
+    }
+
+    uint32_t step_count = static_cast<uint32_t>(params->image.sigma_count - 1);
+    size_t transition_words_per_operator =
+        (static_cast<size_t>(step_count) + 63) / 64;
+    if (transition_words_per_operator == 0 ||
+        params->model_block_operator_count >
+            std::numeric_limits<size_t>::max() /
+                transition_words_per_operator) {
+        return SD_LOOM_STATUS_INVALID_ARGUMENT;
+    }
+    size_t expected_transition_words =
+        params->model_block_operator_count *
+        transition_words_per_operator;
+    if (transition_masks == nullptr ||
+        transition_mask_capacity != expected_transition_words) {
+        return SD_LOOM_STATUS_INVALID_ARGUMENT;
+    }
+
+    std::vector<sd_loom_scheduled_model_block_v4_t> scheduled;
+    try {
+        scheduled.reserve(params->model_block_operator_count);
+        auto krea = std::dynamic_pointer_cast<Krea2::Krea2Runner>(
+            program->context->sd->diffusion_model);
+        int64_t model_block_count = krea == nullptr ? 0 : krea->model_block_count();
+        if (krea == nullptr ||
+            model_block_count <= 0 ||
+            model_block_count >
+                static_cast<int64_t>(std::numeric_limits<uint32_t>::max())) {
+            return SD_LOOM_STATUS_UNSUPPORTED;
+        }
+        for (size_t index = 0;
+             index < params->model_block_operator_count;
+             ++index) {
+            const auto& operator_params = params->model_block_operators[index];
+            if (operator_params.component != SD_LOOM_MODEL_COMPONENT_KREA2_V4 ||
+                operator_params.site != SD_LOOM_MODEL_BLOCK_RESIDUAL_V4 ||
+                operator_params.block >= static_cast<uint64_t>(model_block_count) ||
+                !std::isfinite(operator_params.residual_scale) ||
+                operator_params.residual_scale < -16.f ||
+                operator_params.residual_scale > 16.f ||
+                !sd_loom_valid_model_block_steps_v5(operator_params, step_count)) {
+                return SD_LOOM_STATUS_INVALID_ARGUMENT;
+            }
+            for (size_t prior = 0; prior < index; ++prior) {
+                const auto& prior_params = params->model_block_operators[prior];
+                if (prior_params.operator_index == operator_params.operator_index) {
+                    return SD_LOOM_STATUS_INVALID_ARGUMENT;
+                }
+                if (prior_params.block != operator_params.block) {
+                    continue;
+                }
+                for (uint32_t step = 0; step < step_count; ++step) {
+                    if (sd_loom_model_block_operator_selects_v5(prior_params, step) &&
+                        sd_loom_model_block_operator_selects_v5(operator_params, step)) {
+                        return SD_LOOM_STATUS_INVALID_ARGUMENT;
+                    }
+                }
+            }
+
+            sd_loom_scheduled_model_block_v4_t selected;
+            selected.block = operator_params.block;
+            selected.residual_scale = operator_params.residual_scale;
+            selected.all_steps =
+                operator_params.step_selection == SD_LOOM_STEP_ALL_V4;
+            selected.application_index = index;
+            selected.operator_index = operator_params.operator_index;
+            selected.loaded_model_blocks =
+                static_cast<uint32_t>(model_block_count);
+            selected.selected_transitions.assign(
+                transition_words_per_operator,
+                uint64_t{0});
+            if (!selected.all_steps) {
+                selected.steps.assign(operator_params.steps,
+                                      operator_params.steps +
+                                          operator_params.step_count);
+            }
+            scheduled.push_back(std::move(selected));
+        }
+
+        program->context->sd->loom_model_block_controls = std::move(scheduled);
+        int32_t status = sd_loom_program_generate_image_v3(
+            program,
+            &params->image,
+            condition_callback,
+            condition_callback_data,
+            step_callback,
+            step_callback_data,
+            snapshot_values,
+            snapshot_capacity,
+            &result_out->image);
+        for (const auto& control :
+             program->context->sd->loom_model_block_controls) {
+            if (control.application_index >= application_capacity ||
+                control.selected_transitions.size() !=
+                    transition_words_per_operator) {
+                program->context->sd->loom_model_block_controls.clear();
+                return SD_LOOM_STATUS_NATIVE_ERROR;
+            }
+            application_results[control.application_index] = {
+                control.operator_index,
+                control.loaded_model_blocks,
+                control.block,
+                control.residual_scale,
+                control.application.graph_applications,
+                control.application.ordinary_graphs,
+                control.application.bypassed_graphs,
+                control.application.scaled_residual_graphs,
+            };
+            std::copy(
+                control.selected_transitions.begin(),
+                control.selected_transitions.end(),
+                transition_masks +
+                    control.application_index *
+                        transition_words_per_operator);
+        }
+        result_out->model_block_application_count =
+            params->model_block_operator_count;
+        result_out->transition_words_per_operator =
+            transition_words_per_operator;
+        program->context->sd->loom_model_block_controls.clear();
+        result_out->controls_cleared =
+            program->context->sd->loom_model_block_controls.empty() ? 1 : 0;
+        return status;
+    } catch (...) {
+        program->context->sd->loom_model_block_controls.clear();
+        return SD_LOOM_STATUS_NATIVE_ERROR;
+    }
+}
+
 int32_t sd_loom_program_describe_v3(const sd_loom_program_v3_t* program,
                                     sd_loom_value_handle_v3_t handle,
                                     sd_loom_value_descriptor_v3_t* descriptor_out) {
