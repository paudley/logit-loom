+static bool sd_loom_valid_model_block_steps_v4(
+    const sd_loom_model_block_operator_v4_t& operator_params,
+    uint32_t step_count) {
+    if (operator_params.step_selection == SD_LOOM_STEP_ALL_V4) {
+        return operator_params.steps == nullptr &&
+               operator_params.step_count == 0;
+    }
+    if (operator_params.step_selection != SD_LOOM_STEP_EXACT_V4 ||
+        operator_params.steps == nullptr ||
+        operator_params.step_count == 0 ||
+        operator_params.step_count > step_count) {
+        return false;
+    }
+    for (size_t index = 0; index < operator_params.step_count; ++index) {
+        if (operator_params.steps[index] >= step_count ||
+            (index > 0 &&
+             operator_params.steps[index - 1] >= operator_params.steps[index])) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool sd_loom_model_block_operator_selects_v4(
+    const sd_loom_model_block_operator_v4_t& operator_params,
+    uint32_t step) {
+    if (operator_params.step_selection == SD_LOOM_STEP_ALL_V4) {
+        return true;
+    }
+    return std::binary_search(operator_params.steps,
+                              operator_params.steps + operator_params.step_count,
+                              step);
+}
+
+int32_t sd_loom_program_generate_image_v4(
+    sd_loom_program_v3_t* program,
+    const sd_loom_program_image_params_v4_t* params,
+    sd_loom_condition_cb_v1_t condition_callback,
+    void* condition_callback_data,
+    sd_loom_step_cb_v1_t step_callback,
+    void* step_callback_data,
+    sd_loom_value_handle_v3_t* snapshot_values,
+    size_t snapshot_capacity,
+    sd_loom_program_image_result_v3_t* result_out) {
+    if (result_out != nullptr) {
+        *result_out = {
+            SD_LOOM_PROGRAM_ABI_VERSION,
+            sd_loom_empty_handle_v3(),
+            sd_loom_empty_handle_v3(),
+            0,
+        };
+    }
+    if (snapshot_values != nullptr) {
+        for (size_t snapshot = 0; snapshot < snapshot_capacity; ++snapshot) {
+            snapshot_values[snapshot] = sd_loom_empty_handle_v3();
+        }
+    }
+    if (!sd_loom_program_live_v3(program) ||
+        params == nullptr ||
+        params->abi_version != SD_LOOM_MODEL_BLOCK_ABI_VERSION ||
+        params->image.abi_version != SD_LOOM_PROGRAM_ABI_VERSION ||
+        params->image.sigma_count < 2 ||
+        params->image.sigma_count > 4097 ||
+        params->model_block_operator_count > 64 ||
+        (params->model_block_operator_count > 0 &&
+         params->model_block_operators == nullptr) ||
+        !program->context->sd->loom_model_block_controls.empty()) {
+        return SD_LOOM_STATUS_INVALID_ARGUMENT;
+    }
+
+    uint32_t step_count = static_cast<uint32_t>(params->image.sigma_count - 1);
+    std::vector<sd_loom_scheduled_model_block_v4_t> scheduled;
+    try {
+        scheduled.reserve(params->model_block_operator_count);
+        auto krea = std::dynamic_pointer_cast<Krea2::Krea2Runner>(
+            program->context->sd->diffusion_model);
+        int64_t model_block_count = krea == nullptr ? 0 : krea->model_block_count();
+        if (params->model_block_operator_count > 0 &&
+            (krea == nullptr || model_block_count <= 0)) {
+            return SD_LOOM_STATUS_UNSUPPORTED;
+        }
+        for (size_t index = 0;
+             index < params->model_block_operator_count;
+             ++index) {
+            const auto& operator_params = params->model_block_operators[index];
+            if (operator_params.component != SD_LOOM_MODEL_COMPONENT_KREA2_V4 ||
+                operator_params.site != SD_LOOM_MODEL_BLOCK_RESIDUAL_V4 ||
+                operator_params.block >= static_cast<uint64_t>(model_block_count) ||
+                !std::isfinite(operator_params.residual_scale) ||
+                operator_params.residual_scale < -16.f ||
+                operator_params.residual_scale > 16.f ||
+                !sd_loom_valid_model_block_steps_v4(operator_params, step_count)) {
+                return SD_LOOM_STATUS_INVALID_ARGUMENT;
+            }
+            for (size_t prior = 0; prior < index; ++prior) {
+                const auto& prior_params = params->model_block_operators[prior];
+                if (prior_params.block != operator_params.block) {
+                    continue;
+                }
+                for (uint32_t step = 0; step < step_count; ++step) {
+                    if (sd_loom_model_block_operator_selects_v4(prior_params, step) &&
+                        sd_loom_model_block_operator_selects_v4(operator_params, step)) {
+                        return SD_LOOM_STATUS_INVALID_ARGUMENT;
+                    }
+                }
+            }
+
+            sd_loom_scheduled_model_block_v4_t selected;
+            selected.block = operator_params.block;
+            selected.residual_scale = operator_params.residual_scale;
+            selected.all_steps =
+                operator_params.step_selection == SD_LOOM_STEP_ALL_V4;
+            if (!selected.all_steps) {
+                selected.steps.assign(operator_params.steps,
+                                      operator_params.steps +
+                                          operator_params.step_count);
+            }
+            scheduled.push_back(std::move(selected));
+        }
+
+        struct ClearModelBlockControls {
+            StableDiffusionGGML* runtime = nullptr;
+            ~ClearModelBlockControls() {
+                if (runtime != nullptr) {
+                    runtime->loom_model_block_controls.clear();
+                }
+            }
+        };
+
+        program->context->sd->loom_model_block_controls = std::move(scheduled);
+        ClearModelBlockControls clear{program->context->sd};
+        return sd_loom_program_generate_image_v3(program,
+                                                  &params->image,
+                                                  condition_callback,
+                                                  condition_callback_data,
+                                                  step_callback,
+                                                  step_callback_data,
+                                                  snapshot_values,
+                                                  snapshot_capacity,
+                                                  result_out);
+    } catch (...) {
+        program->context->sd->loom_model_block_controls.clear();
+        return SD_LOOM_STATUS_NATIVE_ERROR;
+    }
+}
+
 int32_t sd_loom_program_describe_v3(const sd_loom_program_v3_t* program,
                                     sd_loom_value_handle_v3_t handle,
                                     sd_loom_value_descriptor_v3_t* descriptor_out) {
