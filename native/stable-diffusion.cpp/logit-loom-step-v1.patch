+int32_t sd_loom_generate_image_v1(sd_ctx_t* sd_ctx,
+                                  const sd_loom_image_params_v1_t* params,
+                                  sd_loom_condition_cb_v1_t condition_callback,
+                                  void* condition_callback_data,
+                                  sd_loom_step_cb_v1_t callback,
+                                  void* callback_data,
