+template <typename T>
+static bool sd_loom_report_condition_tensor(sd_loom_condition_cb_v1_t callback,
+                                            void* callback_data,
+                                            const std::string& label,
+                                            sd_loom_tensor_dtype_t dtype,
+                                            const sd::Tensor<T>& tensor) {
+    sd_loom_condition_tensor_v1_t value = {
+        SD_LOOM_ABI_VERSION,
+        label.c_str(),
+        dtype,
+        tensor.empty() ? nullptr : tensor.data(),
+        static_cast<size_t>(tensor.numel()) * sizeof(T),
+        tensor.shape().empty() ? nullptr : tensor.shape().data(),
+        tensor.shape().size(),
+    };
+    return callback(&value, callback_data) == SD_LOOM_CALLBACK_CONTINUE;
+}
+
+static bool sd_loom_report_condition(sd_loom_condition_cb_v1_t callback,
+                                     void* callback_data,
+                                     const std::string& prefix,
+                                     const SDCondition& condition) {
+    if (!sd_loom_report_condition_tensor(callback, callback_data, prefix + ".c_crossattn", SD_LOOM_TENSOR_F32, condition.c_crossattn) ||
+        !sd_loom_report_condition_tensor(callback, callback_data, prefix + ".c_vector", SD_LOOM_TENSOR_F32, condition.c_vector) ||
+        !sd_loom_report_condition_tensor(callback, callback_data, prefix + ".c_concat", SD_LOOM_TENSOR_F32, condition.c_concat) ||
+        !sd_loom_report_condition_tensor(callback, callback_data, prefix + ".c_t5_ids", SD_LOOM_TENSOR_I32, condition.c_t5_ids) ||
+        !sd_loom_report_condition_tensor(callback, callback_data, prefix + ".c_t5_weights", SD_LOOM_TENSOR_F32, condition.c_t5_weights) ||
+        !sd_loom_report_condition_tensor(callback, callback_data, prefix + ".c_input_ids", SD_LOOM_TENSOR_I32, condition.c_input_ids) ||
+        !sd_loom_report_condition_tensor(callback, callback_data, prefix + ".c_position_ids", SD_LOOM_TENSOR_I32, condition.c_position_ids) ||
+        !sd_loom_report_condition_tensor(callback, callback_data, prefix + ".c_token_types", SD_LOOM_TENSOR_I32, condition.c_token_types) ||
+        !sd_loom_report_condition_tensor(callback, callback_data, prefix + ".c_vinput_mask", SD_LOOM_TENSOR_I32, condition.c_vinput_mask)) {
+        return false;
+    }
+    for (size_t index = 0; index < condition.c_image_embeds.size(); ++index) {
+        const auto& [image_index, tensor] = condition.c_image_embeds[index];
+        if (!sd_loom_report_condition_tensor(callback,
+                                             callback_data,
+                                             prefix + ".c_image_embeds." + std::to_string(index) + "." + std::to_string(image_index),
+                                             SD_LOOM_TENSOR_F32,
+                                             tensor)) {
+            return false;
+        }
+    }
+    for (size_t index = 0; index < condition.c_ref_images.size(); ++index) {
+        if (!sd_loom_report_condition_tensor(callback,
+                                             callback_data,
+                                             prefix + ".c_ref_images." + std::to_string(index),
+                                             SD_LOOM_TENSOR_F32,
+                                             condition.c_ref_images[index])) {
+            return false;
+        }
+    }
+    for (size_t index = 0; index < condition.extra_c_crossattns.size(); ++index) {
+        if (!sd_loom_report_condition_tensor(callback,
+                                             callback_data,
+                                             prefix + ".extra_c_crossattns." + std::to_string(index),
+                                             SD_LOOM_TENSOR_F32,
+                                             condition.extra_c_crossattns[index])) {
+            return false;
+        }
+    }
+    return true;
+}
