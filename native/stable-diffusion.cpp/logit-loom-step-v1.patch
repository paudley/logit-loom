+sd_ctx_t* sd_loom_new_ctx_v1(const sd_loom_ctx_params_v1_t* params) {
+    if (params == nullptr ||
+        params->abi_version != SD_LOOM_ABI_VERSION ||
+        !sd_loom_nonempty(params->diffusion_model_path) ||
+        !sd_loom_nonempty(params->text_encoder_path) ||
+        !sd_loom_nonempty(params->backend) ||
+        !sd_loom_nonempty(params->params_backend) ||
+        params->n_threads <= 0) {
+        return nullptr;
+    }
+
+    sd_ctx_params_t native_params;
+    sd_ctx_params_init(&native_params);
+    native_params.diffusion_model_path = params->diffusion_model_path;
+    native_params.backend              = params->backend;
+    native_params.params_backend       = params->params_backend;
+    native_params.n_threads            = params->n_threads;
+    native_params.enable_mmap          = params->enable_mmap;
+    native_params.flash_attn           = params->flash_attn;
+    native_params.diffusion_flash_attn = params->diffusion_flash_attn;
+    native_params.rng_type             = CPU_RNG;
+    native_params.sampler_rng_type     = CPU_RNG;
+
+    switch (params->profile) {
+        case SD_LOOM_PROFILE_MINIT2I_B16:
+            if (sd_loom_nonempty(params->vae_path)) {
+                return nullptr;
+            }
+            native_params.t5xxl_path = params->text_encoder_path;
+            native_params.prediction = MINIT2I_FLOW_PRED;
+            break;
+        case SD_LOOM_PROFILE_KREA2_TURBO:
+            if (!sd_loom_nonempty(params->vae_path)) {
+                return nullptr;
+            }
+            native_params.llm_path   = params->text_encoder_path;
+            native_params.vae_path   = params->vae_path;
+            native_params.vae_format = SD_VAE_FORMAT_WAN;
+            break;
+        default:
+            return nullptr;
+    }
+
+    // Preserve stdout for the embedding application's structured output.
+    sd_set_progress_callback(sd_loom_discard_progress, nullptr);
+    return new_sd_ctx(&native_params);
+}
