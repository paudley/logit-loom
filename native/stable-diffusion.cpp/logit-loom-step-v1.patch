+    if (image_out != nullptr) {
+        *image_out = nullptr;
+    }
+    if (sd_ctx == nullptr ||
+        sd_ctx->sd == nullptr ||
+        params == nullptr ||
+        image_out == nullptr ||
+        condition_callback == nullptr ||
+        callback == nullptr ||
+        params->abi_version != SD_LOOM_ABI_VERSION ||
+        !sd_loom_nonempty(params->prompt) ||
+        params->width <= 0 ||
+        params->height <= 0 ||
+        params->width > 4096 ||
+        params->height > 4096 ||
+        !std::isfinite(params->cfg_scale) ||
+        params->cfg_scale < 0.f ||
+        params->cfg_scale > 64.f ||
+        params->sigmas == nullptr ||
+        params->sigma_count < 2 ||
+        params->sigma_count > 4097 ||
+        sd_ctx->sd->loom_condition_callback != nullptr ||
+        sd_ctx->sd->loom_step_callback != nullptr) {
+        return SD_LOOM_STATUS_INVALID_ARGUMENT;
+    }
+    for (size_t i = 0; i < params->sigma_count; ++i) {
+        float sigma = params->sigmas[i];
+        if (!std::isfinite(sigma) ||
+            sigma < 0.f ||
+            (i + 1 < params->sigma_count && sigma <= 0.f) ||
+            (i > 0 && params->sigmas[i - 1] < sigma)) {
+            return SD_LOOM_STATUS_INVALID_ARGUMENT;
+        }
