diff --git src/ggml-vulkan/ggml-vulkan-types.h src/ggml-vulkan/ggml-vulkan-types.h
index 51e698a6..1a761161 100644
--- src/ggml-vulkan/ggml-vulkan-types.h
+++ src/ggml-vulkan/ggml-vulkan-types.h
@@ -48,6 +48,9 @@ typedef struct VkPhysicalDeviceCooperativeMatrixDecodeVectorFeaturesNV {
 #endif
 
 #include <algorithm>
+#include <atomic>
+#include <cerrno>
+#include <cstdlib>
 
 #include <cmath>
 
@@ -1043,12 +1046,69 @@ inline void vk_command_pool::destroy(vk::Device& device) {
     cmd_buffers.clear();
 }
 
+struct ggml_vk_logit_loom_budget_config {
+    bool enabled;
+    uint64_t ceiling;
+};
+
+inline ggml_vk_logit_loom_budget_config ggml_vk_logit_loom_budget() {
+    static const ggml_vk_logit_loom_budget_config budget = []() {
+        const char * raw = std::getenv("LOGIT_LOOM_VULKAN_MAX_BYTES");
+        if (raw == nullptr) {
+            return ggml_vk_logit_loom_budget_config{false, 0};
+        }
+        errno = 0;
+        char * end = nullptr;
+        const unsigned long long parsed = std::strtoull(raw, &end, 10);
+        if (errno != 0 || end == raw || *end != '\0' || parsed == 0) {
+            return ggml_vk_logit_loom_budget_config{true, 0};
+        }
+        return ggml_vk_logit_loom_budget_config{
+            true,
+            static_cast<uint64_t>(parsed),
+        };
+    }();
+    return budget;
+}
+
+// One process-wide counter shared by every translation unit of the split
+// Vulkan backend (C++17 inline variable).
+inline std::atomic<uint64_t> ggml_vk_logit_loom_memory_used{0};
+
+inline bool ggml_vk_logit_loom_reserve(uint64_t bytes) {
+    const ggml_vk_logit_loom_budget_config budget = ggml_vk_logit_loom_budget();
+    if (!budget.enabled) {
+        return true;
+    }
+    if (budget.ceiling == 0 || bytes == 0 || bytes > budget.ceiling) {
+        return false;
+    }
+    uint64_t current = ggml_vk_logit_loom_memory_used.load(std::memory_order_relaxed);
+    while (current <= budget.ceiling - bytes) {
+        if (ggml_vk_logit_loom_memory_used.compare_exchange_weak(
+                current,
+                current + bytes,
+                std::memory_order_acq_rel,
+                std::memory_order_relaxed)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+inline void ggml_vk_logit_loom_release(uint64_t bytes) {
+    if (bytes != 0 && ggml_vk_logit_loom_budget().enabled) {
+        ggml_vk_logit_loom_memory_used.fetch_sub(bytes, std::memory_order_acq_rel);
+    }
+}
+
 struct vk_buffer_struct {
     vk::Buffer buffer = VK_NULL_HANDLE;
     vk::DeviceMemory device_memory = VK_NULL_HANDLE;
     vk::MemoryPropertyFlags memory_property_flags;
     void * ptr;
     size_t size = 0;
+    uint64_t guarded_allocation_bytes = 0;
     vk::DeviceAddress bda_addr {};
 
     vk_device device;
@@ -1060,6 +1120,7 @@ struct vk_buffer_struct {
         VK_LOG_DEBUG("~vk_buffer_struct(" << buffer << ", " << size << ")");
 
         device->device.freeMemory(device_memory);
+        ggml_vk_logit_loom_release(guarded_allocation_bytes);
         device->device.destroyBuffer(buffer);
     }
 };
