 #include "ggml-vulkan-shaders.hpp"
 
+struct ggml_vk_logit_loom_budget_config {
+    bool enabled;
+    uint64_t ceiling;
+};
+
+static ggml_vk_logit_loom_budget_config ggml_vk_logit_loom_budget() {
+    static const ggml_vk_logit_loom_budget_config budget = []() {
+        const char * raw = std::getenv("LOGIT_LOOM_VULKAN_MAX_BYTES");
+        if (raw == nullptr) {
+            return ggml_vk_logit_loom_budget_config{false, 0};
+        }
+        errno = 0;
+        char * end = nullptr;
+        const unsigned long long parsed = std::strtoull(raw, &end, 10);
+        if (errno != 0 || end == raw || *end != '\0' || parsed == 0) {
+            return ggml_vk_logit_loom_budget_config{true, 0};
+        }
+        return ggml_vk_logit_loom_budget_config{
+            true,
+            static_cast<uint64_t>(parsed),
+        };
+    }();
+    return budget;
+}
+
+static std::atomic<uint64_t> ggml_vk_logit_loom_memory_used{0};
+
+static bool ggml_vk_logit_loom_reserve(uint64_t bytes) {
+    const ggml_vk_logit_loom_budget_config budget = ggml_vk_logit_loom_budget();
+    if (!budget.enabled) {
+        return true;
+    }
+    if (budget.ceiling == 0 || bytes == 0 || bytes > budget.ceiling) {
+        return false;
+    }
+    uint64_t current = ggml_vk_logit_loom_memory_used.load(std::memory_order_relaxed);
+    while (current <= budget.ceiling - bytes) {
+        if (ggml_vk_logit_loom_memory_used.compare_exchange_weak(
+                current,
+                current + bytes,
+                std::memory_order_acq_rel,
+                std::memory_order_relaxed)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void ggml_vk_logit_loom_release(uint64_t bytes) {
+    if (bytes != 0 && ggml_vk_logit_loom_budget().enabled) {
+        ggml_vk_logit_loom_memory_used.fetch_sub(bytes, std::memory_order_acq_rel);
+    }
+}
+
 // remove this once it's more widely available in the SDK
 #if !defined(VK_KHR_shader_bfloat16)
 
