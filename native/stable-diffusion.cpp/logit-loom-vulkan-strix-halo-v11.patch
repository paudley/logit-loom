 static vk_fa_tuning_params get_fa_tuning_params(const vk_device& device, uint32_t hsk, uint32_t hsv, uint32_t n_rows, uint32_t n_kv, ggml_type k_type, ggml_type v_type, bool f32acc) {
+    // RADV currently exposes cooperative-matrix flash attention on Strix Halo,
+    // but that path can lose the device while the scalar flash-attention path
+    // remains valid. Keep cooperative matrices enabled for other operations and
+    // narrow the workaround to flash attention on the affected PCI device.
+    if (device->vendor_id == VK_VENDOR_ID_AMD && device->properties.deviceID == 0x1586 &&
+        k_type != GGML_TYPE_Q1_0 && v_type != GGML_TYPE_Q1_0) {
+        return get_fa_tuning_params_scalar(device, hsk, hsv, n_rows, n_kv, k_type, v_type, f32acc);
+    }
+
     FaCodePath path = device->coopmat2 ? FA_COOPMAT2 :
                       device->coopmat1_fa_support ? FA_COOPMAT1 : FA_SCALAR;
 
