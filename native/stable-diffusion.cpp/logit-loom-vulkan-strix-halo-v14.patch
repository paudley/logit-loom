diff --git src/ggml-vulkan/ggml-vulkan.cpp src/ggml-vulkan/ggml-vulkan.cpp
--- src/ggml-vulkan/ggml-vulkan.cpp
+++ src/ggml-vulkan/ggml-vulkan.cpp
@@ -15028,10 +15028,24 @@ static void ggml_vk_compute_forward(ggml_backend_vk_context * ctx, ggml_cgraph *
-        if (almost_ready && !ctx->almost_ready_fence_pending) {
-            ggml_vk_submit(subctx, ctx->almost_ready_fence);
-            ctx->almost_ready_fence_pending = true;
-        } else {
-            ggml_vk_submit(subctx, {});
+        try {
+            if (almost_ready && !ctx->almost_ready_fence_pending) {
+                ggml_vk_submit(subctx, ctx->almost_ready_fence);
