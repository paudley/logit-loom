+                    << "; type=" << ggml_type_name(tensor->type)
+                    << "; shape=[" << tensor->ne[0] << ',' << tensor->ne[1] << ',' << tensor->ne[2] << ',' << tensor->ne[3] << ']'
+                    << "; native_error=" << error.what();
+            throw std::runtime_error(message.str());
         }
-        ctx->submit_pending = true;
 
 #ifdef GGML_VULKAN_CHECK_RESULTS
         ggml_vk_synchronize(ctx);
@@ -16531,7 +16545,9 @@ static ggml_status ggml_backend_vk_graph_compute(ggml_backend_t backend, ggml_cg
 
